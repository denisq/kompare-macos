{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kompare",
  "version": "0.2.0",
  "identifier": "com.quentin.kompare",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kompare",
        "width": 1150,
        "height": 780,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Kompare-style visual diff viewer",
    "longDescription": "A reimplementation of KDE's Kompare diff viewer: Rust core, native WebView UI.",
    "fileAssociations": [
      {
        "ext": [
          "diff",
          "patch",
          "dif"
        ],
        "name": "Unified Diff File",
        "description": "Unified diff / patch file",
        "role": "Viewer",
        "mimeType": "text/x-patch"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
