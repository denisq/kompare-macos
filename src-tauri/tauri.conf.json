{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kompare",
  "version": "0.1.0",
  "identifier": "com.quentin.kompare.web",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kompare",
        "width": 1150,
        "height": 780,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
